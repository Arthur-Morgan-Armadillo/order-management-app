{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@/*": ["src/*"],
      "@/common/*": ["src/common/*"],
      "@/database/*": ["src/database/*"],
      "@/product/*": ["src/product/*"],
      "@/user/*": ["src/user/*"],
      "@/order/*": ["src/order/*"],
      "@shared/*": ["../../libs/shared/dist/*"]
    }
  },
  "include": ["src/**/*.ts", "prisma/seed.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../../libs/shared" }]
}
