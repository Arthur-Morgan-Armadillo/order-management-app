generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Added non-negative balance and non-empty name
// check constraints to migration.sql
model User {
  id      String  @id @default(uuid())
  name    String  @db.VarChar(100)
  email   String  @unique @db.VarChar(100)
  balance Decimal @default(100.00) @db.Decimal(18, 2)
  orders  Order[]

  @@map("users")
}

// Added non-negative price and stock
// and non-empty name check constraints to migration.sql
model Product {
  id     String  @id @default(uuid())
  name   String  @db.VarChar(200)
  price  Decimal @db.Decimal(12, 2)
  stock  Int
  orders Order[]

  @@map("products")
}

// Added positive quantity and non-negative total price
// check constraints to migration.sql
model Order {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now()) @map("created_at")
  quantity   Int
  totalPrice Decimal  @map("total_price") @db.Decimal(18, 2)
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @map("user_id")
  product    Product  @relation(fields: [productId], references: [id])
  productId  String   @map("product_id")

  @@index([userId])
  @@index([productId])
  @@map("orders")
}
