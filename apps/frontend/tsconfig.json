{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "outDir": "../../dist/apps/frontend",
    "baseUrl": ".",
    "rootDir": ".",
    "types": [
      "node", 
      "@order-management-monorepo/libs/shared/interfaces", 
      "@order-management-monorepo/libs/shared/enums", 
      "@order-management-monorepo/libs/shared/types"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/app/*": ["./src/app/*"],
      "@/entities/*": ["./src/entities/*"],
      "@/features/*": ["./src/features/*"],
      "@/shared/*": ["./src/shared/*"],
      "@/widgets/*": ["./src/widgets/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
