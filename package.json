{
  "name": "order-management-app",
  "private": true,
  "version": "1.0.0",
  "description": "A monolithic order management application",
  "license": "UNLICENSED",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "backend:build": "cd apps/backend && nest build",
    "backend:start": "cd apps/backend && nest start",
    "backend:start:dev": "cd apps/backend && nest start --watch",
    "backend:start:debug": "cd apps/backend && nest start --debug --watch",
    "backend:start:prod": "cd apps/backend && node dist/src/main.js",
    "backend:prod": "npm run backend:build && npm run backend:start:prod",
    "backend:lint": "cd apps/backend && eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "backend:format": "cd apps/backend && prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "backend:test": "cd apps/backend && jest --config ./jest-config.json",
    "backend:test:watch": "cd apps/backend && jest --config ./jest-config.json --watch",
    "backend:test:cov": "cd apps/backend && jest --config ./jest-config.json --coverage",
    "backend:test:debug": "cd apps/backend && node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "backend:test:e2e": "cd apps/backend && jest --config ./test/jest-e2e.json --runInBand",
    "backend:typecheck": "cd apps/backend && tsc --noEmit",
    "prisma:generate": "cd apps/backend && npx prisma generate",
    "prisma:migrate:dev": "cd apps/backend && npx prisma migrate dev",
    "prisma:migrate:deploy": "cd apps/backend && npx prisma migrate deploy",
    "prisma:seed": "cd apps/backend && npx prisma db seed",
    "prisma:setup": "npm run prisma:generate && npm run prisma:migrate:deploy && npm run prisma:seed",

    "frontend:dev": "cd apps/frontend && next dev -p 5000",
    "frontend:build": "cd apps/frontend && next build",
    "frontend:start": "cd apps/frontend && next start -p 5000",
    "frontend:prod": "npm run frontend:build && npm run frontend:start",
    "frontend:lint": "cd apps/frontend && next lint",
    "frontend:format": "cd apps/frontend && prettier --write .",
    "frontend:typecheck": "cd apps/frontend && tsc --noEmit",

    "app:build": "npm run backend:build && npm run frontend:build",
    "app:start": "npm run backend:start:prod & npm run frontend:start",
    "app:prod": "npm run app:build && npm run app:start",
    "app:lint": "npm run backend:lint && npm run frontend:lint",
    "app:test": "npm run backend:test && npm run frontend:test",
    "app:typecheck": "npm run backend:typecheck && npm run frontend:typecheck"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.5.0",
    "prisma": "^6.7.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",

    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.506.0",
    "next": "15.3.1",
    "next-themes": "^0.4.6",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",

    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint-config-next": "15.3.1",
    "prettier": "3.5.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.2.8"
  }
}
